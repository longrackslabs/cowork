#!/bin/bash
# Prevent committing files with secrets

# Patterns that indicate secret material
PATTERNS=(
  'EBAY_CLIENT_SECRET'
  'EBAY_USER_REFRESH_TOKEN'
  'EBAY_APP_ACCESS_TOKEN'
  'EBAY_USER_ACCESS_TOKEN'
  'GOOGLE_APPLICATION_CREDENTIALS.*\.json'
  'AIza[0-9A-Za-z_-]{35}'
  'api[_-]?key\s*=\s*["\x27][^"\x27]{10,}'
  'secret\s*=\s*["\x27][^"\x27]{10,}'
  'password\s*=\s*["\x27][^"\x27]{6,}'
  'BEGIN (RSA|EC|OPENSSH) PRIVATE KEY'
)

STAGED=$(git diff --cached --name-only)

for file in $STAGED; do
  for pattern in "${PATTERNS[@]}"; do
    if git show ":$file" 2>/dev/null | grep -qiE "$pattern"; then
      echo "ERROR: Possible secret found in $file (pattern: $pattern)"
      echo "Remove the secret before committing."
      exit 1
    fi
  done
done

exit 0
